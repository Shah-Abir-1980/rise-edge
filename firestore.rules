rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function sid() { return exists(/databases/$(d)/documents/map/$(request.auth.uid)) ? get(/databases/$(d)/documents/map/$(request.auth.uid)).data.sid : request.auth.uid; }
    function adm() { return request.auth != null && get(/databases/$(d)/documents/users/$(sid())).data.role == 'admin'; }
    function cadm() { return request.auth != null && (get(/databases/$(d)/documents/users/$(sid())).data.role == 'admin' || (get(/databases/$(d)/documents/users/$(sid())).data.role == 'teacher' && get(/databases/$(d)/documents/users/$(sid())).data.get('ca', false) == true && get(/databases/$(d)/documents/users/$(sid())).data.get('active', true) != false)); }
    function myb() { return get(/databases/$(d)/documents/users/$(sid())).data.get('bid', ''); }
    function fresh() { return !exists(/databases/$(d)/documents/config/init); }
    function tch(b) { return request.auth != null && get(/databases/$(d)/documents/users/$(sid())).data.role == 'teacher' && b in get(/databases/$(d)/documents/users/$(sid())).data.bids; }
    function tpub() { return get(/databases/$(d)/documents/users/$(sid())).data.get('pub', false) == true; }
    match /{c}/{id} { allow read, write: if adm() || (cadm() && c != 'users' && c != 'log'); }
    match /config/{id} { allow read: if true; allow create: if request.auth != null && fresh(); }
    match /users/{id} {
      allow read: if cadm();
      allow create: if cadm() && request.resource.data.role in ['student', 'teacher'] && request.resource.data.get('ca', false) == false;
      allow delete: if cadm() && resource.data.role in ['student', 'teacher'] && resource.data.get('ca', false) == false;
      allow update: if cadm() && resource.data.role != 'admin' && request.resource.data.role == resource.data.role && request.resource.data.get('ca', false) == resource.data.get('ca', false);
      allow read: if request.auth != null && sid() == id;
      allow read: if tch(resource.data.bid);
      allow create: if request.auth != null && sid() == id && fresh() && request.resource.data.role == 'admin';
      allow update: if request.auth != null && sid() == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange', 'pic', 'phone', 'addr', 'gname', 'gphone', 'bg']);
      allow update: if tch(resource.data.bid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']);
    }
    match /batches/{id} {
      allow read: if request.auth != null;
      allow update: if tch(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start']);
    }
    match /pay/{id} { allow read: if request.auth != null && resource.data.sid == sid(); }
    match /att/{id} {
      allow get: if tch(id.split('_')[0]);
      allow list: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid);
      allow update, delete: if tch(resource.data.bid);
    }
    match /exams/{id} {
      allow read: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid) && (tpub() || request.resource.data.get('pub', false) == false);
      allow update: if tch(resource.data.bid) && tch(request.resource.data.bid) && (tpub() || request.resource.data.get('pub', false) == resource.data.get('pub', false));
    }
    match /hw/{id} {
      allow read: if request.auth != null && resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.bid;
      allow read: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid);
      allow update: if tch(resource.data.bid) && tch(request.resource.data.bid);
    }
    match /nt/{id} {
      allow read: if request.auth != null && resource.data.to == sid();
      allow read: if request.auth != null && resource.data.to == 'batch' && resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow read: if resource.data.to == 'batch' && tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid) && request.resource.data.to in ['batch', 'admin'];
      allow create: if tch(get(/databases/$(d)/documents/users/$(request.resource.data.to)).data.get('bid', ''));
    }
    match /rq/{id} {
      allow read: if request.auth != null && resource.data.sid == sid();
      allow read: if resource.data.h == 't' && tch(resource.data.bid);
      allow create: if request.auth != null && request.resource.data.sid == sid() && request.resource.data.st == 'new' && request.resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow update: if resource.data.h == 't' && tch(resource.data.bid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'rp']);
    }
    match /fl/{id} {
      allow read: if request.auth != null && resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow read: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid);
      allow delete: if tch(resource.data.bid);
    }
    match /fd/{id} {
      allow read: if request.auth != null && resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow read: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid);
      allow delete: if tch(resource.data.bid);
    }
    match /sy/{id} {
      allow read: if request.auth != null && resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow read: if tch(resource.data.bid);
      allow create: if tch(request.resource.data.bid);
      allow delete: if tch(resource.data.bid);
    }
    match /sp/{id} {
      allow read: if request.auth != null && resource.data.sid == sid();
      allow read: if tch(resource.data.bid);
      allow create: if request.auth != null && request.resource.data.sid == sid() && request.resource.data.ok.size() == 0 && request.resource.data.bid == get(/databases/$(d)/documents/users/$(sid())).data.get('bid', '');
      allow update: if request.auth != null && resource.data.sid == sid() && request.resource.data.ok == resource.data.ok;
      allow update: if tch(resource.data.bid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'sel', 'rej']);
    }
    match /map/{id} { allow read: if request.auth != null && request.auth.uid == id; }
    match /log/{id} { allow read: if cadm(); allow create: if cadm() && request.resource.data.uid == sid(); }
    match /login/{id} { allow read: if true; }
    match /rep/{id} {
      allow get: if tch(id.split('_')[0]);
      allow create, update: if tch(request.resource.data.bid);
    }
    match /users/{id}/reports/{r} {
      allow read: if request.auth != null && sid() == id;
      allow write: if cadm() || tpub() && tch(get(/databases/$(d)/documents/users/$(id)).data.bid);
    }
    match /records/{id} { allow read: if tch(resource.data.bid); allow create: if tch(request.resource.data.bid); }
    match /users/{id}/hist/{h} {
      allow read: if request.auth != null && sid() == id;
      allow create: if cadm() || tch(get(/databases/$(d)/documents/users/$(id)).data.bid);
    }
    match /sd/{id} {
      allow read: if request.auth != null && (tch(id) || myb() == id);
      allow write: if tch(id);
    }
    match /ms/{id} {
      allow read: if request.auth != null && sid() == id;
      allow read: if tch(resource.data.bid);
      allow create, update: if request.auth != null && sid() == id && request.resource.data.sid == id && request.resource.data.bid == myb();
    }
    match /yr/{id} {
      allow get: if tch(id.split('_')[0]);
      allow read: if request.auth != null && resource.data.pub == true && resource.data.bid == myb();
    }
  }
}
